# Kopieer dit bestand naar .env en vul in
OPENAI_API_KEY=sk-...
# Zet hier het sterkste model dat jouw OpenAI-account heeft (bijv. gpt-4o of nieuwer):
OPENAI_MODEL=gpt-4o
PORT=3100
# De chat zit achter de site-basic-auth (nginx) en draait alleen op 127.0.0.1,
# dus een aparte code is niet nodig. Leeg = geen tweede wachtwoordprompt.
TOEGANGSCODE=
MAX_TOKENS=8192
